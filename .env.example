# -----------------------------------------------------------------------------
# NexusRAG Core Environment Configuration
# -----------------------------------------------------------------------------

# Application
APP_NAME=nexus-rag-core
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (PostgreSQL + pgvector)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexus_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@postgres:5432/nexus_rag
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (Semantic Cache & Rate Limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_THRESHOLD=0.92

# Rate Limiter
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# AI / LLM Integration
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# RAG Pipeline Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SIMILARITY_TOP_K=5
HYBRID_SEARCH_ALPHA=0.7
